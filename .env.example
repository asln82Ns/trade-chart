# Copy this file to .env and fill in your real values.
# .env is gitignored.

# Databento Historical API key. Sign in at https://databento.com to get yours.
DATABENTO_API_KEY=db-your-api-key-here

# Optional. Where to keep cached parquet files. Defaults to server/data_cache.
# DATA_CACHE_DIR=server/data_cache

# Optional. Comma-separated allowed CORS origins for the frontend.
# Defaults to http://localhost:8000,http://127.0.0.1:8000.
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
